<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device transfer for Android 12 and higher -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="note_database.db" />
        <include domain="database" path="note_database.db-wal" />
        <include domain="database" path="note_database.db-shm" />
        <include domain="sharedpref" path="shared_prefs_notes.xml" />
        <include domain="sharedpref" path="locked_notes_vault.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="note_database.db" />
        <include domain="database" path="note_database.db-wal" />
        <include domain="database" path="note_database.db-shm" />
        <include domain="sharedpref" path="shared_prefs_notes.xml" />
        <include domain="sharedpref" path="locked_notes_vault.xml" />
    </device-transfer>
</data-extraction-rules>
