            <extra android:name="type" android:value="CHECKLIST" />
        </intent>
    </shortcut>
    <shortcut
        android:icon="@drawable/ic_shortcut_shopping"
        android:shortcutId="new_shopping"
        android:shortcutShortLabel="@string/new_shopping">
        <intent
            android:action="info.sergeikolinichenko.closednotepad.action.NEW_NOTE"
            android:targetClass="info.sergeikolinichenko.closednotepad.presentation.MainActivity"
            android:targetPackage="info.sergeikolinichenko.closednotepad">
            <extra android:name="type" android:value="SHOPPING" />
