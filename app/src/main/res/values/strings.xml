    <!-- Encryption of locked notes -->
    <string name="about_locked_notes_body_plain">A locked note opens only after your fingerprint, face or screen lock, but its text is still stored unencrypted. Set a password to encrypt locked notes.</string>
    <string name="note_encrypted_title_open">Note encrypted. Its title stays readable, for search.</string>
    <string name="vault_setup_title">Encrypt locked notes</string>
    <string name="vault_setup_body">Locked notes will be stored encrypted. They will open with your fingerprint or screen lock, as before. The password is a spare key: you need it if the fingerprint and screen lock stop opening the notes, for example after the screen lock is turned off or on a new phone.</string>
    <string name="vault_encrypt">Encrypt</string>
