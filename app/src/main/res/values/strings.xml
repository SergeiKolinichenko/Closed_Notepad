    <string name="vault_unlock_body">The fingerprint and screen lock can\'t open locked notes right now. Enter the password you set for them.</string>
    <string name="vault_password">Password</string>
    <string name="vault_password_repeat">Repeat password</string>
    <string name="vault_password_short">At least 6 characters</string>
    <string name="vault_password_mismatch">Passwords don\'t match</string>
    <string name="vault_wrong_password">Wrong password</string>
    <string name="vault_understand">I understand that a forgotten password can\'t be recovered</string>
    <string name="vault_warning_titles">Titles of locked notes are not encrypted: they are visible in the list, and search finds notes by them. Don\'t put anything secret in a title.</string>
    <string name="vault_warning_no_recovery">If you forget the password and the fingerprint and screen lock no longer open the notes, locked notes can\'t be recovered. Nobody can reset the password, not even the developer.</string>
