<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/widget_new_text"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/new_note"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_new_note" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/new_note"
            android:textColor="@color/widget_ink"
            android:textSize="16sp" />

        <!-- Widgets may only use the views RemoteViews allows, so the dot is an ImageView -->
        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_seal" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_new_checklist"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/new_checklist"
        android:padding="12dp"
        android:src="@drawable/ic_new_checklist" />

    <ImageView
        android:id="@+id/widget_new_shopping"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/new_shopping"
        android:padding="12dp"
        android:src="@drawable/ic_new_shopping" />
</LinearLayout>
